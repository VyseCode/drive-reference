# MongoDB connection string. Local mongod is expected for the reference app.
MONGODB_URI=mongodb://127.0.0.1:27017/drive_ref
# HS256 secret for the session JWT stored in the HTTP-only cookie.
JWT_SECRET=replace-with-a-long-random-string
# Separate HS256 secret for signed share-link tokens.
SHARE_SECRET=replace-with-a-different-long-random-string
# Only "local" is implemented. See README for the object-storage swap path.
STORAGE_DRIVER=local
# Directory for local blob storage (relative to the project root).
STORAGE_DIR=.data/blobs
# Public base URL used when copying share links.
NEXT_PUBLIC_APP_URL=http://localhost:3224
